# App access. Production refuses sensitive routes if these are missing.
APP_ACCESS_CODE=
APP_SESSION_SECRET=

# Google Drive service account. Share the Jack Dee Ultimate Job Search Tool folder with this service-account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_MASTER_FOLDER_ID=
GOOGLE_APPLICATION_PACKAGES_FOLDER_ID=
GOOGLE_APPLIED_FOLDER_ID=
GOOGLE_INTERVIEWING_FOLDER_ID=
GOOGLE_OFFERS_FOLDER_ID=
GOOGLE_CLOSED_FOLDER_ID=
GOOGLE_ARCHIVE_FOLDER_ID=

# Vercel AI Gateway. On Vercel, OIDC is preferred and no static key is required.
AI_MODEL=openai/gpt-5.6-sol
AI_GATEWAY_API_KEY=

# Optional broad job discovery providers. Public remote providers work without these.
SERPAPI_KEY=
RAPIDAPI_JSEARCH_KEY=

# Scheduled search endpoint authentication.
CRON_SECRET=
JOB_SEARCH_APP_URL=

# Local development only. Never enable in production.
USE_LOCAL_STATE=true
